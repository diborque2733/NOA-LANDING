# ──────────────────────────────────────────────────────────────────
# NOA Landing — Environment Variables
# Copia este archivo a `.env.local` y rellena los valores
# ──────────────────────────────────────────────────────────────────

# ─── Formulario de contacto (Resend) ─────────────────────────────
# Genera tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=rfuentes@noa-core.com,lpualuan@noa-core.com
CONTACT_EMAIL_FROM=NOA Landing <noreply@noa-core.com>

# ─── Stack de desarrollo multi-LLM (uso interno, NO se expone al landing) ──
# Estos keys los usás vos durante el dev con tu CLI/IDE preferido (Cursor, Cline, aider, etc.)
# La estrategia de routing por costo está documentada en `docs/dev-stack.md`

# Anthropic — Claude (mejor para razonamiento complejo, código grande)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — GPT (mejor para refactors rápidos, integración tools)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Google — Gemini (mejor para procesar contexto largo, costo bajo)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Site config ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://noa-core.com
